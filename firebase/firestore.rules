rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validProfile(uid) {
      let p = request.resource.data;
      return p.keys().hasAll(['uid', 'nickname', 'avatarId', 'createdAt', 'lastLoginAt', 'schemaVersion'])
        && p.keys().hasOnly(['uid', 'nickname', 'avatarId', 'createdAt', 'lastLoginAt', 'schemaVersion'])
        && p.uid == uid && p.schemaVersion == 1
        && p.nickname is string && p.nickname.matches('[^@<>]{1,24}')
        && p.avatarId in ['villager-default', 'villager-blue', 'villager-rose']
        && p.createdAt is timestamp && p.lastLoginAt is timestamp;
    }
    match /players/{uid} {
      allow get: if googleUser(uid);
      allow create: if googleUser(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if googleUser(uid) && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'avatarId', 'lastLoginAt'])
        && request.resource.data.lastLoginAt == request.time;
      allow list, delete: if false;
    }
    // Server-confirmed characters and rewards. Do not accept local EXP/LV or
    // completion flags as authority; only Admin backend transactions may write.
    match /players/{uid}/characters/{characterId} {
      allow get: if googleUser(uid) && characterId == 'primary';
      allow list, write: if false;
      match /progression/{documentId} {
        allow get: if googleUser(uid) && characterId == 'primary' && documentId == 'experience';
        allow list, write: if false;
      }
      match /experienceReceipts/{receiptId} {
        allow read: if googleUser(uid) && characterId == 'primary';
        allow write: if false;
      }
      match /experienceCompletions/{completionId} {
        allow read: if googleUser(uid) && characterId == 'primary';
        allow write: if false;
      }
      match /questIndex/{documentId} {
        allow get: if googleUser(uid) && characterId == 'primary' && documentId == 'tv1-hk1-v1';
        allow list, write: if false;
      }
      match /questRuns/{questId} {
        allow read: if googleUser(uid) && characterId == 'primary';
        allow write: if false;
      }
      match /questAssignments/{assignmentId} {
        allow read: if googleUser(uid) && characterId == 'primary';
        allow write: if false;
      }
      // Proximity proofs are internal to the trusted game server, never a
      // client-writeable flag or a browser position accepted as authority.
      match /questInteractionProofs/{proofId} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
