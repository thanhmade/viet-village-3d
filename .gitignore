# Keep all old backups, including the Git bundle, on disk only.
# Ignoring a directory does not delete or overwrite its contents.
/BACKUP/

# Separate cap-nhat worktree: never include it or a gitlink on main.
/VIET-VILLAGE-3D-CAP-NHAT/

# Only the two development documents below belong in the repository.
# Original lessons, chat context, provenance, audit manifests and connection
# reports stay on this computer and are excluded from Git.
/DOCUMENTS/*
!/DOCUMENTS/EXPORT-STATUS.md
!/DOCUMENTS/VALIDATION.md

# Local reports and audit tools must not be committed if copied here later.
/audit-*.py
/verify-stage*.py
/stage*-audit.json
/stage*-baseline.json
/stage*-verification.json
/stage*-github-confirmation.json
/README-before-stage*.md

# Deliberately retained: SOURCE-CODE, ASSETS, MAP, BUILDINGS, CHARACTERS,
# INTERIORS, ENVIRONMENT, exported models and reference images.
# Git ignores do not define which files a public website is allowed to serve.
