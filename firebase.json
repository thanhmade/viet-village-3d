{
  "hosting": {
    "site": "viet-village-3d",
    "public": "public-game",
    "predeploy": [
      "node scripts/build-public-game.mjs"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*teacher*",
      "**/private/**",
      "**/*answer-key*",
      "**/BACKUP/**",
      "**/DOCUMENTS/**",
      "**/scripts/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "village-rooms",
      "runtime": "nodejs22"
    }
  ],
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 5005
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8081
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9001
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
